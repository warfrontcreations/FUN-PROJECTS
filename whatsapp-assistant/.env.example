# Copy this file to .env and fill in your key (.env is gitignored, never commit it)

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use for generating replies
MODEL=claude-haiku-4-5-20251001

# draft = log what it *would* reply, but don't actually send (safe for testing)
# send  = actually send the generated reply on WhatsApp
MODE=draft

# Skip group chats entirely (recommended — avoids the bot going off in a group)
SKIP_GROUPS=true

# Optional: comma-separated list of WhatsApp JIDs to restrict replies to while
# testing, e.g. 923001234567@s.whatsapp.net. Leave empty to allow all chats
# (only do this once you trust it in MODE=send).
ALLOWED_JIDS=

# Optional: comma-separated list of WhatsApp JIDs to NEVER auto-reply to,
# even if ALLOWED_JIDS is empty (e.g. family, work contacts you want to
# handle yourself). Same JID format as ALLOWED_JIDS.
EXCLUDED_JIDS=
